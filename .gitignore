# ==============================================================================
# CivicSutra AI — Root Git Ignore Configuration
# Protects secrets, credentials, databases, dependencies, and temporary build caches
# ==============================================================================

# 1. Dependency Directories (Root & All Subprojects)
node_modules/
*/node_modules/
**/node_modules/

# 2. Production Build & Bundler Artifacts
dist/
dist-ssr/
build/
out/
*/dist/
**/dist/
*.local

# 3. Python Cache, Bytecode & Virtual Environments
__pycache__/
*/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# 4. Testing, Coverage & Cache Folders
.pytest_cache/
*/.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
.hypothesis/

# 5. Environment Variables & Secrets (Keep .env.example safe)
.env
.env.*
*.env
*.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*
secrets.json

# 6. Relational Databases & Local Storage Engines
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
backend/*.db
backend/*.db-wal
backend/*.db-shm
backend/*.sqlite
backend/*.sqlite3
server/data/*.json

# 7. Runtime Logs & Process Dumps
*.log
logs/
*/logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 8. Operating System & IDE Specific Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
