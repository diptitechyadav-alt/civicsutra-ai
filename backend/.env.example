# ==============================================================================
# CivicSutra AI — Environment Configuration Template
# NOTE: Use placeholder values only. Never commit real keys or secrets to git.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL / Supabase / SQLite Fallback)
# Set DATABASE_URL to your PostgreSQL or Supabase connection string.
# Leave empty or set to sqlite:///civicsutra.db for local persistent file storage.
DATABASE_URL=sqlite:///civicsutra.db
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# AI Intelligence Service Provider (Optional - works in DEMO MODE if left unset)
# Supported Providers: google_gemini, openai, anthropic, demo
AI_PROVIDER=demo
GEMINI_API_KEY=your-gemini-api-key-placeholder
OPENAI_API_KEY=your-openai-api-key-placeholder

# Similarity & Clustering Parameters
DUPLICATE_DISTANCE_THRESHOLD_METERS=150
SEMANTIC_SIMILARITY_THRESHOLD_PCT=60
AUTO_CLUSTER_MIN_REPORTS=2

# Priority Scoring Weights (Must sum to 100%)
WEIGHT_SEVERITY=30
WEIGHT_RELATED_REPORTS=20
WEIGHT_LOCATION_IMPACT=20
WEIGHT_UNRESOLVED_DURATION=15
WEIGHT_RECURRENCE=10
WEIGHT_EVIDENCE_QUALITY=5

# Security & Session Secrets
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
